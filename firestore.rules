rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'harinath78811388@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'phone', 'service', 'message', 'createdAt', 'status']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 150 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
        (!('service' in data) || (data.service is string && data.service.size() <= 100)) &&
        (!('status' in data) || (data.status in ['new', 'in-review', 'contacted', 'archived']));
    }

    function isValidJobApplication(data) {
      return data.keys().hasAll(['jobId', 'fullName', 'email', 'createdAt']) &&
        data.keys().hasOnly(['jobId', 'fullName', 'email', 'phone', 'experience', 'portfolioUrl', 'coverLetter', 'status', 'createdAt']) &&
        data.jobId is string && data.jobId.size() <= 50 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
        (!('experience' in data) || (data.experience is string && data.experience.size() <= 50)) &&
        (!('portfolioUrl' in data) || (data.portfolioUrl is string && data.portfolioUrl.size() <= 250)) &&
        (!('coverLetter' in data) || (data.coverLetter is string && data.coverLetter.size() <= 3000)) &&
        (!('status' in data) || (data.status in ['submitted', 'reviewing', 'shortlisted', 'rejected']));
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['certificateId', 'studentName', 'courseTitle', 'issueDate', 'valid']) &&
        data.certificateId is string && data.certificateId.size() <= 60 &&
        data.studentName is string && data.studentName.size() <= 120 &&
        data.courseTitle is string && data.courseTitle.size() <= 150 &&
        data.valid is bool;
    }

    // Contact Inquiries
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Career Job Applications
    match /job_applications/{applicationId} {
      allow create: if isValidId(applicationId) && isValidJobApplication(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Academy Certificates (Public read for authenticity verification, Admin-only write)
    match /certificates/{certificateId} {
      allow get: if isValidId(certificateId);
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidCertificate(request.resource.data);
    }

    // Admin List
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
